-- 5. ฟังก์ชันค้นหาและแสดงผลตามตัวอักษรที่พิมพ์
-- ==========================================
local function renderSearch(query)
	-- ล้างรายการเก่าทิ้งก่อน
	for _, child in ipairs(scrollingFrame:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	query = string.lower(query or "")

	-- หากช่องค้นหาว่าง ให้แสดงข้อความแนะนำ
	if query == "" then
		local hintCard = Instance.new("Frame")
		hintCard.Size = UDim2.new(1, 0, 0, 50)
		hintCard.BackgroundColor3 = Color3.fromRGB(34, 34, 46)
		hintCard.Parent = scrollingFrame

		local hintCorner = Instance.new("UICorner")
		hintCorner.CornerRadius = UDim.new(0, 8)
		hintCorner.Parent = hintCard

		local hintText = Instance.new("TextLabel")
		hintText.Size = UDim2.new(1, 0, 1, 0)
		hintText.BackgroundTransparency = 1
		hintText.TextColor3 = Color3.fromRGB(150, 150, 160)
		hintText.TextSize = 14
		hintText.Font = Enum.Font.Gotham
		hintText.Text = "พิมพ์ตัวอักษรหรือคำที่คุณต้องการค้นหา..."
		hintText.Parent = hintCard
		return
	end

	local foundCount = 0

	-- วนลูปค้นหาคำที่ตรงกับตัวอักษรที่พิมพ์ในฐานข้อมูล
	for _, item in ipairs(database) do
		-- ตรวจสอบว่าคำที่พิมพ์ไปอยู่ใน ชื่อ, หมวดหมู่ หรือ เนื้อหา หรือไม่
		if string.find(string.lower(item.title), query) or 
			string.find(string.lower(item.category), query) or
			string.find(string.lower(item.content), query) then

			foundCount = foundCount + 1

			-- สร้างการ์ดแสดงผลคำที่ตรงกัน
			local card = Instance.new("Frame")
			card.Size = UDim2.new(1, 0, 0, 85)
			card.BackgroundColor3 = Color3.fromRGB(34, 34, 46)
			card.Parent = scrollingFrame

			local cardCorner = Instance.new("UICorner")
			cardCorner.CornerRadius = UDim.new(0, 8)
			cardCorner.Parent = card

			local catLabel = Instance.new("TextLabel")
			catLabel.Size = UDim2.new(1, -20, 0, 20)
			catLabel.Position = UDim2.new(0, 10, 0, 8)
			catLabel.BackgroundTransparency = 1
			catLabel.TextColor3 = Color3.fromRGB(100, 180, 255)
			catLabel.TextSize = 12
			catLabel.Font = Enum.Font.GothamBold
			catLabel.Text = "📁 หมวดหมู่: " .. item.category
			catLabel.TextXAlignment = Enum.TextXAlignment.Left
			catLabel.Parent = card

			local itemTitle = Instance.new("TextLabel")
			itemTitle.Size = UDim2.new(1, -20, 0, 22)
			itemTitle.Position = UDim2.new(0, 10, 0, 28)
			itemTitle.BackgroundTransparency = 1
			itemTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
			itemTitle.TextSize = 14
			itemTitle.Font = Enum.Font.GothamBold
			itemTitle.Text = item.title
			itemTitle.TextXAlignment = Enum.TextXAlignment.Left
			itemTitle.Parent = card

			local itemContent = Instance.new("TextLabel")
			itemContent.Size = UDim2.new(1, -20, 0, 25)
			itemContent.Position = UDim2.new(0, 10, 0, 52)
			itemContent.BackgroundTransparency = 1
			itemContent.TextColor3 = Color3.fromRGB(180, 180, 190)
			itemContent.TextSize = 12
			itemContent.Font = Enum.Font.Gotham
			itemContent.Text = item.content
			itemContent.TextWrapped = true
			itemContent.TextXAlignment = Enum.TextXAlignment.Left
			itemContent.Parent = card
		end
	end

	-- หากค้นหาไม่พบข้อมูล
	if foundCount == 0 then
		local notFoundCard = Instance.new("Frame")
		notFoundCard.Size = UDim2.new(1, 0, 0, 50)
		notFoundCard.BackgroundColor3 = Color3.fromRGB(34, 34, 46)
		notFoundCard.Parent = scrollingFrame

		local notFoundCorner = Instance.new("UICorner")
		notFoundCorner.CornerRadius = UDim.new(0, 8)
		notFoundCorner.Parent = notFoundCard

		local notFoundText = Instance.new("TextLabel")
		notFoundText.Size = UDim2.new(1, 0, 1, 0)
		notFoundText.BackgroundTransparency = 1
		notFoundText.TextColor3 = Color3.fromRGB(220, 100, 100)
		notFoundText.TextSize = 14
		notFoundText.Font = Enum.Font.Gotham
		notFoundText.Text = 'ไม่พบคำว่า "' .. query .. '" ในระบบสารานุกรม'
		notFoundText.Parent = notFoundCard
	end
end

